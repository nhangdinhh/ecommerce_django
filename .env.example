# Local development settings. Copy this file to .env and replace secret values.
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# PostgreSQL is optional. Use the overlay file documented in AWS_AND_DATABASE.md.
POSTGRES_DB=nhang_shop
POSTGRES_USER=nhang_shop
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Configure real SMTP credentials before enabling order emails outside local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Nhang Shop <no-reply@example.com>
